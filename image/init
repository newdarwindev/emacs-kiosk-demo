#!/bin/sh
# PID 1 in the disposable RAM-only demo. No network, disks, getty or SSH.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /run /tmp /var/log
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
chmod 1777 /tmp /dev/shm
exec >/dev/ttyS0 2>&1
set -x
hostname emacs-kiosk
printf 'KIOSK_LINUX_BOOT kernel=%s\n' "$(uname -r)"
/sbin/udevd --daemon
udevadm trigger --action=add
udevadm settle --timeout=30
modprobe bochs || true
modprobe bochs_drm || true
modprobe evdev || true
mkdir -p /run/user/1000
chown 1000:1000 /run/user/1000
chmod 700 /run/user/1000
su kiosk -c 'python3 /opt/kiosk/slack-mock.py && /opt/kiosk/demo-agent.sh && sleep 1 && tmux capture-pane -pt demo' 
printf 'KIOSK_FIXTURES_COMPLETE\n'
Xorg :0 -noreset -nolisten tcp -ac -logfile /var/log/Xorg.0.log vt1 &
xpid=$!
n=0
while [ ! -S /tmp/.X11-unix/X0 ] && kill -0 "$xpid" 2>/dev/null; do
  sleep 1; n=$((n+1)); [ "$n" -lt 40 ] || break
done
cat /var/log/Xorg.0.log || true
if [ -S /tmp/.X11-unix/X0 ]; then
  printf 'KIOSK_X_READY\n'
  while true; do
    su kiosk -c 'DISPLAY=:0 XDG_RUNTIME_DIR=/run/user/1000 /opt/kiosk/start-kiosk.sh'
    printf 'KIOSK_SESSION_RESTART\n'
    sleep 1
  done
fi
printf 'KIOSK_X_FAILED\n'
while true; do sleep 60; done
